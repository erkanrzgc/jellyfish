# Jellyfish gemma4 + DPO, merged and quantized on the pod (cloud/pod_dpo_gemma4.sh). Text only: no projector or
# draft, like models/Modelfile.g4-requant (the stock control from the same convert+quantize). Put the GGUF next to
# this file, then: ollama create jellyfish-g4-dpo -f models/Modelfile.g4-dpo
# Ollama 0.40.16 rejects new LoRA adapters, so the adapter cannot be applied on top of gemma4:e4b.
FROM ./jellyfish-g4-dpo-Q4_K_M.gguf
RENDERER gemma4
PARSER gemma4
PARAMETER temperature 1
PARAMETER top_k 64
PARAMETER top_p 0.95
